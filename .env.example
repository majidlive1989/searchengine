# Run python scripts/configure.py to generate a unique first-run password.
ADMIN_EMAIL=admin@agency.local
ADMIN_PASSWORD=CHANGE_TO_A_RANDOM_PASSWORD_OF_AT_LEAST_12_CHARACTERS
DATABASE_PATH=data/copilot.db
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEMO=true
# Optional environment defaults. You can instead configure Gemini inside Settings after startup.
# Configure BOTH fields if using environment defaults. Pick a generateContent-compatible model available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: private, trusted authorized execution service; never a supplier URL.
# In Docker, use http://host.docker.internal:9000 or an internal service name.
EXECUTION_BRIDGE_URL=
EXECUTION_BRIDGE_TOKEN=

# Optional absolute path for local encryption key; default is beside the database.
# ATLAS_VAULT_KEY_FILE=/secure/path/vault.key
